# BioGuard X experimental FastAPI API configuration.
# Never commit a real .env file or place these secrets in frontend/config.js.
BIOGUARD_API_TOKEN=replace-with-a-long-random-secret
BIOGUARD_ENCRYPTION_KEY=generate-with-Fernet-and-keep-stable
BIOGUARD_DB_PATH=api/bioguard.sqlite3
BIOGUARD_MODEL_PATH=reports/bioguard_traditional_ml.joblib
BIOGUARD_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
